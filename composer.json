{
    "name": "lucas/lucas-app",
    "description": "Lucas: finanzas personales y compartidas (PHP sin framework). Este composer.json solo declara las herramientas de desarrollo; la aplicación no tiene dependencias.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": { "php": "8.4.0" }
    },
    "scripts": {
        "analizar": "phpstan analyse --memory-limit=512M",
        "estilo": "php-cs-fixer fix --dry-run --diff --allow-risky=no",
        "estilo:arreglar": "php-cs-fixer fix --allow-risky=no"
    }
}
