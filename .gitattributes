# Garantiza finales de línea LF (Unix) en Linux, Windows y macOS.
# Sin esto, Git en Windows (core.autocrlf=true) convierte los .sh a CRLF y los contenedores Linux fallan al arrancar.
* text=auto eol=lf

*.sh text eol=lf
bin/* text eol=lf
Dockerfile text eol=lf
*.sql text eol=lf
*.php text eol=lf
*.conf text eol=lf
*.template text eol=lf
*.ini text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.png binary
*.ico binary
*.gz binary
