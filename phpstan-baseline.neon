parameters:
	ignoreErrors:
		-
			message: '#^Match expression does not handle remaining value\: string$#'
			identifier: match.unhandled
			count: 1
			path: src/app/Admin/GestionUsuarios.php

		-
			message: '#^Using nullsafe property access "\?\-\>contrasenaHash" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Auth/Autenticador.php

		-
			message: '#^Method App\\Auth\\DosPasos\:\:regenerarCodigos\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Auth/DosPasos.php

		-
			message: '#^Offset ''moneda'' does not exist on array\{nombre\: string, tipo\: string, saldo_inicial\: string, dia_corte\: int\|null, dia_pago_limite\: int\|null\}\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: src/app/Controller/CuentaController.php

		-
			message: '#^Offset ''tasa_mensual_bps'' does not exist on array\{nombre\: string, tipo\: string, saldo_inicial\: string, dia_corte\: int\|null, dia_pago_limite\: int\|null\}\.$#'
			identifier: offsetAccess.notFound
			count: 2
			path: src/app/Controller/CuentaController.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: src/app/Controller/PresupuestoController.php

		-
			message: '#^Using nullsafe property access "\?\-\>saldo" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Deudas/GestionDeudas.php

		-
			message: '#^Property App\\Domain\\Deuda\:\:\$nombre \(string\) on left side of \?\? is not nullable\.$#'
			identifier: nullCoalesce.property
			count: 2
			path: src/app/Deudas/PlanificadorDeudas.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: src/app/Domain/Cuenta.php

		-
			message: '#^Strict comparison using \!\=\= between mixed and null will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: src/app/Domain/Transferencia.php

		-
			message: '#^Method App\\Mail\\SmtpMailer\:\:command\(\) has parameter \$expected with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Mail/SmtpMailer.php

		-
			message: '#^Method App\\Movimientos\\Filtros\:\:hayAlguno\(\) has parameter \$f with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Movimientos/Filtros.php

		-
			message: '#^Comparison operation "\>" between \*NEVER\* and 1 results in an error\.$#'
			identifier: greater.invalid
			count: 1
			path: src/app/Movimientos/GestionMovimientos.php

		-
			message: '#^Using nullsafe property access "\?\-\>saldo" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 2
			path: src/app/Movimientos/GestionMovimientos.php

		-
			message: '#^Using nullsafe property access "\?\-\>saldo" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Recurrentes/GestionRecurrentes.php

		-
			message: '#^Method App\\Repository\\CategoriaRepository\:\:listVisible\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Repository/CategoriaRepository.php

		-
			message: '#^Method App\\Repository\\CuentaRepository\:\:listByUser\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Repository/CuentaRepository.php

		-
			message: '#^Method App\\Repository\\DosPasosRepository\:\:datos\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Repository/DosPasosRepository.php

		-
			message: '#^Method App\\Repository\\DosPasosRepository\:\:reemplazarCodigos\(\) has parameter \$hashes with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Repository/DosPasosRepository.php

		-
			message: '#^Method App\\Repository\\MovimientoRepository\:\:todasLasRutasAdjuntos\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Repository/MovimientoRepository.php

		-
			message: '#^Function current_user\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Security/session.php

		-
			message: '#^Function pending_two_factor\(\) return type has no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Security/session.php

		-
			message: '#^Method App\\Support\\Dinero\:\:sumar\(\) has parameter \$montos with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/Support/Dinero.php

		-
			message: '#^Using nullsafe property access "\?\-\>idCuentaDestino" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Transferencias/GestionTransferencias.php

		-
			message: '#^Using nullsafe property access "\?\-\>idCuentaOrigen" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Transferencias/GestionTransferencias.php

		-
			message: '#^Using nullsafe property access "\?\-\>saldo" on left side of \?\? is unnecessary\. Use \-\> instead\.$#'
			identifier: nullsafe.neverNull
			count: 1
			path: src/app/Transferencias/GestionTransferencias.php

		-
			message: '#^Method App\\View\\Html\:\:join\(\) has parameter \$parts with no value type specified in iterable type iterable\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/View/Html.php

		-
			message: '#^Method App\\View\\Ui\:\:actions\(\) has parameter \$items with no value type specified in iterable type array\.$#'
			identifier: missingType.iterableValue
			count: 1
			path: src/app/View/Ui.php

		-
			message: '#^Offset ''editor''\|''lector'' on array\{propietario\: ''Propietario'', editor\: ''Editor'', lector\: ''Lector \(solo…''\} on left side of \?\? always exists and is not nullable\.$#'
			identifier: nullCoalesce.offset
			count: 1
			path: src/views/app/espacios.php
