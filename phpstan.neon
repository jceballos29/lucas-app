# Análisis estático (R8 / N9 de docs/AUDITORIA.md). Nivel 7 con línea base vacía (0 errores en phpstan-baseline.neon).
# Ejecutar:  bin/estatico analizar    (o, con Composer instalado, `composer analizar`)
includes:
    - phpstan-baseline.neon
parameters:
    level: 7
    paths:
        - src/app
        - src/public
        - src/scripts
        - src/views
    excludePaths:
        - src/storage
    bootstrapFiles:
        - src/app/Security/session.php
        - src/app/Security/csrf.php
        - src/app/Security/origin.php
        - src/app/Security/request-guard.php
    tmpDir: .phpstan.cache
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # PDO::ATTR_ERRMODE = ERRMODE_EXCEPTION (Connection.php): PDO::query() y PDOStatement::fetchAll() lanzan PDOException, nunca devuelven false.
        - '#Cannot call method fetch(?:All|Column)?\(\) on PDOStatement\|false\.#'
        - '#Argument of an invalid type PDOStatement\|false supplied for foreach#'
        # PDOStatement::fetchAll() devuelve una lista 0..N-1 y array_map() sobre una sola lista conserva las claves secuenciales (list<T>).
        - '#Method App\\Repository\\.*::.*\(\) should return list<.*> but returns array<.*>\.#'
