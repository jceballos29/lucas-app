# --- Aplicación ---
# Entorno. local = errores en pantalla, status.php disponible y opcache revalidando. Cualquier otro valor
# (por ejemplo production) = modo seguro: errores solo en el log, status.php responde 404.
APP_ENV=local
APP_PORT=8090
# Origen público de la aplicación (esquema + host + puerto, sin ruta). Opcional: por defecto
# es http://localhost:APP_PORT. Fíjalo si usas otro host o HTTPS (p. ej. https://sitio.com).
# Ojo: localhost y 127.0.0.1 son orígenes distintos; abre la app con el mismo que pongas aquí.
# APP_ORIGIN=http://localhost:8090

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lucas
# Usuario de la APLICACIÓN: solo puede leer y escribir filas (SELECT/INSERT/UPDATE); nada de DROP, ALTER ni DELETE.
# Lo crea database/03-users.sh. Valores de DESARROLLO: cámbialos fuera de tu máquina.
DB_USERNAME=lucas_app
DB_PASSWORD=lucas_app_dev_2026
# Usuario de MIGRACIONES y tareas manuales: permisos de esquema sobre la base. PHP no lo conoce (bin/as-migrator).
DB_MIGRATION_USERNAME=lucas_migrator
DB_MIGRATION_PASSWORD=lucas_migrator_dev_2026
# root de MySQL: solo para administrar el servidor (crear usuarios, bases temporales de las pruebas).
DB_ROOT_PASSWORD=lucas_root_dev_2026

# --- Herramientas ---
ADMINER_PORT=8091

# --- Permisos de archivos (ejecuta `id -u` e `id -g` en Linux/WSL) ---
HOST_UID=1000
HOST_GID=1000

# --- Xdebug ---
XDEBUG_MODE=off
