# --- Aplicación ---
# Entorno. local = errores en pantalla, status.php disponible y opcache revalidando. Cualquier otro valor
# (por ejemplo production) = modo seguro: errores solo en el log, status.php responde 404.
APP_ENV=local
APP_PORT=8090
# Origen público de la aplicación (esquema + host + puerto, sin ruta). Opcional: por defecto
# es http://localhost:APP_PORT. Fíjalo si usas otro host o HTTPS (p. ej. https://sitio.com).
# Ojo: localhost y 127.0.0.1 son orígenes distintos; abre la app con el mismo que pongas aquí.
# APP_ORIGIN=http://localhost:8090

# Clave que cifra los secretos del 2FA en la base de datos (≥ 32 caracteres). En desarrollo hay una por defecto; en producción es
# obligatoria: `openssl rand -base64 32`. Si la pierdes o la cambias, hay que reactivar el 2FA de todos. No la subas a git.
# APP_KEY=
# Administradores obligados a activar el 2FA: vacío = sí, salvo con APP_ENV=local. Pon 0 o 1 para forzarlo.
# ADMIN_2FA_OBLIGATORIO=

# --- Base de datos ---
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lucas
# Usuario de la APLICACIÓN: solo puede leer y escribir filas (SELECT/INSERT/UPDATE); nada de DROP, ALTER ni DELETE.
# Lo crea database/03-users.sh. Valores de DESARROLLO: cámbialos fuera de tu máquina.
DB_USERNAME=lucas_app
DB_PASSWORD=lucas_app_dev_2026
# Usuario de MIGRACIONES y tareas manuales: permisos de esquema sobre la base. PHP no lo conoce (bin/as-migrator).
DB_MIGRATION_USERNAME=lucas_migrator
DB_MIGRATION_PASSWORD=lucas_migrator_dev_2026
# root de MySQL: solo para administrar el servidor (crear usuarios, bases temporales de las pruebas).
DB_ROOT_PASSWORD=lucas_root_dev_2026

# --- Rendimiento (PHP-FPM) ---
# Tamaño del pool de procesos. Los valores por defecto (40) aguantaron 500 usuarios simultáneos en las pruebas (docs/DESPLIEGUE.md).
# Regla práctica: memoria disponible para PHP ÷ ~40 MB por proceso, sin pasar de max_connections de MySQL (151).
# PHP_FPM_MAX_CHILDREN=40
# PHP_FPM_START_SERVERS=10
# PHP_FPM_MIN_SPARE=5
# PHP_FPM_MAX_SPARE=15

# --- Correo (recuperación de contraseña) ---
# En desarrollo no hace falta tocar nada: el correo va a Mailpit (contenedor `mailpit`, interfaz en MAILPIT_PORT).
# En producción apunta a tu SMTP real. MAIL_ENCRYPTION: none (solo Mailpit local), starttls (puerto 587) o tls (puerto 465).
# MAIL_HOST=smtp.tuproveedor.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=starttls
# MAIL_USER=usuario
# MAIL_PASSWORD=clave
# MAIL_FROM=no-responder@tudominio.com
# MAIL_FROM_NAME=Lucas

# --- Herramientas ---
ADMINER_PORT=8091
MAILPIT_PORT=8025

# --- Permisos de archivos (ejecuta `id -u` e `id -g` en Linux/WSL) ---
HOST_UID=1000
HOST_GID=1000

# --- Xdebug ---
XDEBUG_MODE=off
