# Imagen de PRODUCCIÓN (B1 de docs/AUDITORIA.md). Se construye desde la RAÍZ del repositorio:
#   docker compose -f docker-compose.prod.yml up -d --build        (el compose ya lo indica: context «.» y este archivo)
#
# Diferencias con docker/php/Dockerfile (desarrollo):
#   - El código VA DENTRO de la imagen, de solo lectura para el usuario con el que corre PHP: si alguien consiguiera ejecutar código en el
#     servidor, no podría modificar la aplicación de forma persistente. Lo único escribible es `storage/` (los comprobantes), que es un volumen.
#   - Sin git, unzip, Composer ni Xdebug: nada que sirva para instalar o depurar dentro del contenedor. Las dependencias se instalan en una
#     etapa aparte (--no-dev, autoload optimizado) y solo se copia el resultado.
#   - OPcache no revalida archivos (el código no cambia sin reconstruir la imagen) → más rápido y sin sorpresas.
#   - Incluye database/migrations para scripts/migrate.php (en desarrollo se monta como volumen).
# Versión de parche fijada, igual que en desarrollo: sube el número a propósito y vuelve a pasar las pruebas.

# ---- Etapa 1: dependencias y autoload optimizado ----------------------------------------------------------------------------------
FROM composer:2.11.3 AS vendor
WORKDIR /app
COPY src/ ./
RUN composer install --no-dev --no-interaction --no-progress --no-scripts --no-plugins --classmap-authoritative --ignore-platform-reqs \
    && rm -rf /root/.composer /tmp/*

# ---- Etapa 2: la imagen final ----------------------------------------------------------------------------------------------------
FROM php:8.4.27-fpm AS prod

ARG HOST_UID=1000
ARG HOST_GID=1000

COPY --from=ghcr.io/mlocati/php-extension-installer:2.13.1 /usr/bin/install-php-extensions /usr/local/bin/
RUN install-php-extensions pdo_mysql intl zip opcache \
    && rm -f /usr/local/bin/install-php-extensions

# -o: ver docker/php/Dockerfile (el grupo primario de macOS ya existe en Debian).
RUN usermod -u ${HOST_UID} -o www-data && groupmod -g ${HOST_GID} -o www-data

ENV PHP_FPM_MAX_CHILDREN=40 \
    PHP_FPM_START_SERVERS=10 \
    PHP_FPM_MIN_SPARE=5 \
    PHP_FPM_MAX_SPARE=15
COPY docker/php/zz-pool.conf /usr/local/etc/php-fpm.d/zz-pool.conf
COPY docker/php/php.ini /usr/local/etc/php/conf.d/99-app.ini
# Solo se carga con APP_ENV=production (PHP_INI_SCAN_DIR del compose de producción).
COPY docker/php/php.prod.ini /usr/local/etc/php/env/production/99-prod.ini

COPY docker/php/entrypoint.sh /usr/local/bin/app-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/app-entrypoint.sh && chmod 755 /usr/local/bin/app-entrypoint.sh

# El código: de root y sin permiso de escritura para los demás (www-data solo lo lee). `storage/` es el punto de montaje del volumen
# de comprobantes; las migraciones van aparte, en /var/www/database, que es donde las busca scripts/migrate.php.
COPY --from=vendor --chown=root:root /app/ /var/www/html/
COPY --chown=root:root database/migrations /var/www/database/migrations
RUN rm -rf /var/www/html/tests /var/www/html/storage \
    && mkdir /var/www/html/storage \
    && chown -R root:root /var/www/html /var/www/database \
    && find /var/www/html /var/www/database -type d -exec chmod 755 {} + \
    && find /var/www/html /var/www/database -type f -exec chmod 644 {} + \
    && chown www-data:www-data /var/www/html/storage && chmod 750 /var/www/html/storage

WORKDIR /var/www/html
USER www-data

ENTRYPOINT ["/bin/sh", "/usr/local/bin/app-entrypoint.sh"]
CMD ["php-fpm"]
